# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública
NEXT_PUBLIC_APP_URL=http://localhost:3000
VERCEL_URL=
NEXT_PUBLIC_PORTFOLIO_CONTACT_URL=

# Evolution / WhatsApp
EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_WEBHOOK_SECRET=

# IA (NEXT_OPENAI_API_KEY e OPENAI_KEY são aliases legados)
OPENAI_API_KEY=
NEXT_OPENAI_API_KEY=
OPENAI_KEY=
OPENAI_MODEL=gpt-4o-mini

# Prospecção — basta uma das fontes; a tela mostra só as configuradas.
# Google Places API (New): Google Cloud > APIs > "Places API (New)" + faturamento
# ativo. 1.000 buscas/mês grátis na faixa com telefone e site.
GOOGLE_PLACES_API_KEY=
# Apify (robô do Google Maps, passa de 60 resultados e traz e-mail/Instagram).
APIFY_TOKEN=
# Opcional: outro ator do Apify no lugar de compass/crawler-google-places.
APIFY_MAPS_ACTOR=
LOCALPROSPECTS_API_KEY=

# Meta (Instagram, Página e anúncios da INSYT) — ver docs/marketing-meta.md
META_APP_ID=
META_APP_SECRET=
# Opcional: versão da Graph API (padrão v23.0)
META_GRAPH_VERSION=
# Opcional: id da configuração do "Facebook Login for Business"
META_LOGIN_CONFIG_ID=

# Cron dos posts agendados (Vercel Cron manda "Authorization: Bearer <valor>")
CRON_SECRET=
