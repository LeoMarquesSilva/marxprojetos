# Gerado no build (src/config/htaccess.ts). Não editar à mão.
Options -Indexes -MultiViews
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://casaampla.com.br%{REQUEST_URI} [R=301,L]

# Site antigo
RewriteRule ^quem-somos/nossa-historia/?$ /a-casa [R=301,L,NE]
RewriteRule ^equipe/17/mente-ativa/?$ /equipes/mente-ativa [R=301,L,NE]
RewriteRule ^equipe/18/vitalidade-em-foco/?$ /equipes/vitalidade-em-foco [R=301,L,NE]
