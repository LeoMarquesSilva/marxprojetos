RewriteRule ^terapias-integrativas/8/reiki/?$ /oficinas-e-terapias\#reiki [R=301,L,NE]
RewriteRule ^terapias-integrativas/9/shiatsu/?$ /oficinas-e-terapias\#shiatsu [R=301,L,NE]

# /pagina → /pagina.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(avif|webp|jpg|png|svg|woff2|js|css)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
