RewriteRule ^profissional/26/juliana-fazzolari/?$ /profissionais/juliana-fazzolari [R=301,L,NE]
RewriteRule ^oficinas/3/cafe-com-memoria/?$ /oficinas-e-terapias\#cafe-com-memoria [R=301,L,NE]
RewriteRule ^oficinas/4/espiritualidade/?$ /oficinas-e-terapias\#espiritualidade [R=301,L,NE]
