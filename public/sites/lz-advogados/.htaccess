# LZ Advogados – configuração Apache (Hostinger / cPanel)
# Vai junto com o build (dist/.htaccess). Em hospedagens não Apache (Vercel, Netlify),
# os redirecionamentos do astro.config.mjs continuam funcionando como fallback.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) HTTPS + www (URL canônica: https://www.lzadvogados.adv.br)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.lzadvogados.adv.br%{REQUEST_URI} [L,R=301]

  # 2) URLs do site antigo (WordPress) -> novas páginas (301 permanente, preserva SEO)
  RewriteRule ^nosso-time/?$ /equipe/ [L,R=301]
  RewriteRule ^nossa-cultura/?$ /o-escritorio/ [L,R=301]
  RewriteRule ^lucas-zenatti/?$ /equipe/lucas-zenatti/ [L,R=301]
  RewriteRule ^radames-sossomeier/?$ /equipe/radames-sossmeier/ [L,R=301]
  RewriteRule ^jeniffer-rech/?$ /equipe/jeniffer-rech/ [L,R=301]
  RewriteRule ^thuany-cristini-cunha/?$ /equipe/thuany-cunha/ [L,R=301]
  RewriteRule ^vinicius-galvao-dos-reis/?$ /equipe/vinicius-galvao-dos-reis/ [L,R=301]
  RewriteRule ^sofia-suffiatti/?$ /equipe/sofia-suffiatti/ [L,R=301]
  RewriteRule ^parcerias-estrategicas-e-sociedade-em-conta-de-participacao-scp-o-caminho-juridico-para-crescer-em-tempos-de-incerteza/?$ /blog/parcerias-estrategicas-e-sociedade-em-conta-de-participacao-scp/ [L,R=301]
  RewriteRule ^gestao-de-pessoas-na-nova-economia-o-que-esta-travando-o-crescimento-da-sua-empresa/?$ /blog/gestao-de-pessoas-na-nova-economia/ [L,R=301]
  RewriteRule ^pagina-exemplo/?$ / [L,R=301]
  RewriteRule ^feed/?$ /rss.xml [L,R=301]
  RewriteRule ^(wp-sitemap|sitemap_index)\.xml$ /sitemap-index.xml [L,R=301]
  RewriteRule ^category/ /blog/ [L,R=301]
  RewriteRule ^author/ /equipe/ [L,R=301]

  # 3) Barra final nas páginas (evita conteúdo duplicado /pagina e /pagina/)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,6}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

# Tipos de arquivo
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddCharset utf-8 .txt .xml .html .css .js .webmanifest
</IfModule>

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/rss+xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Cache: arquivos com hash (_astro) e fontes por 1 ano; imagens por 30 dias; HTML sempre revalidado
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Segurança
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>
